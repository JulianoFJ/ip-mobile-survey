# Copie para .env (nunca versionado) e ajuste.
IPS_ENV=local
IPS_LOG_LEVEL=INFO
IPS_LOG_JSON=false

# PostgreSQL + PostGIS
IPS_DB_HOST=localhost
IPS_DB_PORT=5432
IPS_DB_NAME=ipsurvey
IPS_DB_USER=ipsurvey
IPS_DB_PASSWORD=ipsurvey

# Object storage (MinIO local / S3 em produção)
IPS_S3_ENDPOINT_URL=http://localhost:9000
IPS_S3_BUCKET=ipsurvey
IPS_S3_ACCESS_KEY=minioadmin
IPS_S3_SECRET_KEY=minioadmin
IPS_S3_REGION=sa-east-1

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# CRS de processamento padrão (UTM SIRGAS 2000 23S, BH)
IPS_PROCESSING_CRS=EPSG:31983

# Fontes externas
IPS_MAPILLARY_TOKEN=
